# ════════════════════════════════════════════════════════════════════════════
# AI-CDSS Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production          # development | production
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (simple, local):
DATABASE_URL=sqlite:///./ai_cdss.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_cdss

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * only for local development — never in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── ML Models ─────────────────────────────────────────────────────────────────
MODEL_PATH=../ml/models

# ── RAG / NLP ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=../rag/vector_db

# ── LLM (optional — leave blank to disable) ───────────────────────────────────
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── OCR Tools (optional) ──────────────────────────────────────────────────────
# macOS: brew install tesseract poppler
TESSERACT_CMD=
POPPLER_PATH=
