# Copy this file to backend/.env and fill in values for your machine.
# IMPORTANT: .env must live in the backend/ directory, not the project root.
# The FastAPI app changes its working directory to backend/ on startup
# (see run_backend.py), and pydantic-settings loads ".env" relative to CWD.

# --- Database ---
# The code's ACTUAL default (backend/app/core/config.py) is SQLite:
#   DATABASE_URL: str = "sqlite:///./ai_cdss.db"
# This is what the application uses right now, since no DATABASE_URL is
# set anywhere else in this repo. This file does NOT change that default -
# it's left commented out on purpose. docker-compose.yml defines a Postgres
# service and requirements.txt includes psycopg2-binary, but neither is
# currently wired to the running app; nothing here migrates or switches
# the database. If/when you deliberately want Postgres, start it with
# `docker compose up -d postgres` and uncomment the line below yourself:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cdss

# --- JWT ---
# Change this in any shared/deployed environment. Not required for local dev.
# JWT_SECRET_KEY=change_me

# --- OCR (Week 2) ---
# Path to the tesseract executable on YOUR machine.
# Leave blank/omit if `tesseract` is already on your system PATH.
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS (Homebrew) example: TESSERACT_CMD=/opt/homebrew/bin/tesseract
# Linux example: TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=

# Folder containing poppler's pdftoppm/pdftocairo binaries, needed for PDF OCR.
# Leave blank/omit if poppler is already on your system PATH.
# This repo already bundles Windows poppler binaries at backend/tools/poppler —
# Windows users can point directly at that folder:
# POPPLER_PATH=./tools/poppler
POPPLER_PATH=

# --- RAG retrieval (Week 5) ---
# The curated documents are stored in ../rag/documents. The MiniLM model is
# downloaded once by sentence-transformers and then cached locally.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./rag/vector_db

# --- Grounded RAG answering (Week 6) ---
# The answer endpoint only uses retrieved local evidence. Never put this key in
# frontend variables or commit backend/.env.
LLM_PROVIDER=openai
LLM_API_KEY=
# Choose a model available to your OpenAI project.
LLM_MODEL=
