  "architecture_audit": {
    "nnunet_clarification": "The third model is implemented via MONAI DynUNet (Dynamic Residual Encoder-Decoder with nnU-Net heuristic topology). It is not the standalone CLI nnUNetv2 Python framework.",
    "dataset_audit": {
      "training_and_validation_dataset": "UPenn-GBM (TCIA) standardized cohort (14 subjects)",
      "held_out_internal_test_dataset": "UPenn-GBM held-out partition (4 subjects: UPENN-GBM-00030_11, 00031_11, 00033_11, 00035_11)",
      "external_validation_investigation": "Medical Segmentation Decathlon (MSD) Task01 BrainTumour was investigated and accessed on AWS S3 (7.6 GB). Full external validation run on MSD was limited by S3 remote streaming bandwidth on large 4D NIfTI archives, so UPenn-GBM served as primary standardized pipeline.",
      "patient_level_leakage": "Verified strictly 0 patient overlap across train, validation, and test sets."
    }
  },
  "methodology_definitions": {
    "threshold_optimization": "Operating point threshold selection (theta in [0, 1]) tuned exclusively on the 4 validation subjects (UPENN-GBM-00020_11, 00021_11, 00026_11, 00029_11) to address severe foreground/background class imbalance. Held-out test patients were strictly unseen during threshold tuning.",
    "probability_calibration": "Evaluating whether predicted posterior probabilities match true empirical event frequencies. Assessed via Expected Calibration Error (ECE ~ 0.46 - 0.50), reflecting uncalibrated logit overconfidence.",
    "spatial_uncertainty": "Voxel-wise epistemic uncertainty quantified via Monte Carlo Dropout predictive entropy H(x) and variance, identifying ambiguous infiltrating tumor margins without altering classification boundaries.",
    "enhancing_tumor_sparsity_analysis": "Enhancing Tumor (ET) occupies only 0.001% - 0.01% of all evaluated voxels (e.g., 1,633 voxels in UPENN-GBM-00031_11). Without spatial attention gates, standard 3D U-Net and DynUNet skip connections diffuse localized T1ce contrast enhancement, collapsing test-time probability below threshold. Attention U-Net employs grid-based spatial attention gates that suppress non-tumor features while amplifying hyperintense rims, successfully detecting ET (mean Dice 0.5109)."
  }
}